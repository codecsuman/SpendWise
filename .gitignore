# ============================================================
# SpendWise - .gitignore
# Allowed in the repo: backend/ , frontend/ , README.md , .gitignore
# Everything else stays on this computer.
# ============================================================

# ---- LOCAL ONLY: AI rules, tools, private notes ----
AGENTS.md
AI-RULES.md
tools/
notes/
scratch/
*.private.md

# ---- SECRETS (never push) ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
serviceAccount.json

# ---- dependencies ----
node_modules/
.pnp
.pnp.js
jspm_packages/

# ---- build output ----
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.turbo/
.vite/
*.tsbuildinfo
coverage/
.nyc_output/

# ---- logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- runtime data / uploads ----
uploads/
tmp/
temp/
.cache/

# ---- editor + OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# ---- local env / misc ----
*.local
.eslintcache
.oxlintcache
